# Copy this file to keystore.properties (same directory) and fill in real values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# storeFile: path to your release .keystore/.jks file (absolute, or relative to the project root)
storeFile=/path/to/release.keystore
# storePassword: the keystore's password
storePassword=CHANGE_ME
# keyAlias: the alias of the signing key inside the keystore
keyAlias=CHANGE_ME
# keyPassword: the password for that specific key alias (may be the same as storePassword)
keyPassword=CHANGE_ME
